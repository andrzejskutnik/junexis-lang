<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Pakuj jako globalny dotnet tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>junexis-lsp</ToolCommandName>
    <PackageId>Junexis.LspHost</PackageId>
    <Description>Junexis Lang Language Server Protocol host (stdio)</Description>
    <PackageTags>junexis;lsp;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OmniSharp.Extensions.LanguageServer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JunexisLang.Compiler.Core\JunexisLang.Compiler.Core.csproj" />
    <ProjectReference Include="..\JunexisLang.Compiler.Topology\JunexisLang.Compiler.Topology.csproj" />
  </ItemGroup>

</Project>
