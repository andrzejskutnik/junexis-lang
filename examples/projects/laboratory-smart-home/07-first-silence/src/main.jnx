// Laboratorium Junexis — Dom 7: pierwszy brak danych.
// Zatrzymany salon nie wysyła komunikatu "offline". Jego kanał naprawdę milczy.

struct HomeSignal {
    kind: Text
    room: Text
    air_quality: Float
    source_status: Text
    silence_age_ms: Int
    silence_timeout_ms: Int
    observed_at: Time
}

struct HomeDecision {
    room: Text
    air_quality: Float
    outcome: Text
    reason: Text
    source_status: Text
    silence_age_ms: Int
    silence_timeout_ms: Int
    decided_at: Time
}

struct VentilationCommand {
    room: Text
    air_quality: Float
    decision: Text
    requested_enabled: Bool
    execution_mode: Text
    cause: Text
    source_status: Text
    silence_age_ms: Int
    silence_timeout_ms: Int
    issued_at: Time
}

struct VentilationConfirmation {
    room: Text
    air_quality: Float
    decision: Text
    requested_enabled: Bool
    actual_enabled: Bool
    status: Text
    cause: Text
    source_status: Text
    silence_age_ms: Int
    silence_timeout_ms: Int
    confirmed_at: Time
}

extern laboratory HomeFailure {
    target server
    language go
    file "user/server/home_failure.go"

    fn salon_available() -> Bool
    fn record_salon(observed_at: Time, air_quality: Float)
    fn health() -> HomeSignal
    fn publish(confirmation: VentilationConfirmation)
}

extern task HomeFailure_salon_available() @server -> Bool
extern task HomeFailure_record_salon(observed_at: Time, air_quality: Float) @server
extern task HomeFailure_health() @server -> HomeSignal
extern task HomeFailure_publish(confirmation: VentilationConfirmation) @server

task RoomSensors() @server -> chan<HomeSignal> {
    state step: Int = 0

    every 1s {
        step = step + 1

        if step == 1 {
            if HomeFailure_salon_available() {
                var salon_value: Float = 1250.0
                let salon_time = now()
                HomeFailure_record_salon(salon_time, salon_value)
                send HomeSignal {
                    kind: "reading", room: "salon", air_quality: salon_value,
                    source_status: "online", silence_age_ms: 0,
                    silence_timeout_ms: 4500, observed_at: salon_time
                }
            }
        }

        if step == 2 {
            send HomeSignal {
                kind: "reading", room: "kuchnia", air_quality: 780.0,
                source_status: "online", silence_age_ms: 0,
                silence_timeout_ms: 4500, observed_at: now()
            }
        }

        if step == 3 {
            send HomeSignal {
                kind: "reading", room: "sypialnia", air_quality: 920.0,
                source_status: "online", silence_age_ms: 0,
                silence_timeout_ms: 4500, observed_at: now()
            }
            step = 0
        }
    }
}

task SilenceMonitor() @server -> chan<HomeSignal> {
    every 1s {
        let health = HomeFailure_health()
        send health
    }
}

task HomeSignalMerge(
    readings: chan<HomeSignal>,
    health: chan<HomeSignal>
) @server -> chan<HomeSignal> {
    loop {
        let reading = recv readings
        send reading
        let health_signal = recv health
        send health_signal
    }
}

task HomeDecisionEngine(signals: chan<HomeSignal>) @server -> chan<HomeDecision> {
    config {
        air_quality_threshold: Float : 1000.0
    }

    loop {
        let signal = recv signals

        if signal.kind == "reading" and signal.air_quality <= config.air_quality_threshold {
            send HomeDecision {
                room: signal.room, air_quality: signal.air_quality,
                outcome: "observe", reason: "świeży pomiar nie przekracza progu",
                source_status: signal.source_status, silence_age_ms: signal.silence_age_ms,
                silence_timeout_ms: signal.silence_timeout_ms, decided_at: now()
            }
        }

        if signal.kind == "reading" and signal.air_quality > config.air_quality_threshold {
            send HomeDecision {
                room: signal.room, air_quality: signal.air_quality,
                outcome: "enable-ventilation", reason: "świeży pomiar przekracza próg",
                source_status: signal.source_status, silence_age_ms: signal.silence_age_ms,
                silence_timeout_ms: signal.silence_timeout_ms, decided_at: now()
            }
        }

        if signal.kind == "source-health" and signal.source_status == "silent" {
            send HomeDecision {
                room: signal.room, air_quality: signal.air_quality,
                outcome: "hold-source-silent",
                reason: "nie nadszedł pomiar przed upływem limitu ciszy",
                source_status: signal.source_status, silence_age_ms: signal.silence_age_ms,
                silence_timeout_ms: signal.silence_timeout_ms, decided_at: now()
            }
        }
    }
}

task VentilationController(decisions: chan<HomeDecision>) @server -> chan<VentilationCommand> {
    loop {
        let decision = recv decisions

        if decision.outcome == "observe" {
            send VentilationCommand {
                room: decision.room, air_quality: decision.air_quality, decision: decision.outcome,
                requested_enabled: false, execution_mode: "applied",
                cause: decision.reason, source_status: decision.source_status,
                silence_age_ms: decision.silence_age_ms,
                silence_timeout_ms: decision.silence_timeout_ms, issued_at: now()
            }
        }
        if decision.outcome == "enable-ventilation" {
            send VentilationCommand {
                room: decision.room, air_quality: decision.air_quality, decision: decision.outcome,
                requested_enabled: true, execution_mode: "applied",
                cause: decision.reason, source_status: decision.source_status,
                silence_age_ms: decision.silence_age_ms,
                silence_timeout_ms: decision.silence_timeout_ms, issued_at: now()
            }
        }
        if decision.outcome == "hold-source-silent" {
            send VentilationCommand {
                room: decision.room, air_quality: decision.air_quality, decision: decision.outcome,
                requested_enabled: false, execution_mode: "limited-source-silent",
                cause: decision.reason, source_status: decision.source_status,
                silence_age_ms: decision.silence_age_ms,
                silence_timeout_ms: decision.silence_timeout_ms, issued_at: now()
            }
        }
    }
}

task VentilationActuator(commands: chan<VentilationCommand>) @server -> chan<VentilationConfirmation> {
    state living_room_enabled: Bool = false
    state kitchen_enabled: Bool = false
    state bedroom_enabled: Bool = false

    loop {
        let command = recv commands

        if command.execution_mode == "applied" and command.room == "salon" {
            living_room_enabled = command.requested_enabled
        }
        if command.execution_mode == "applied" and command.room == "kuchnia" {
            kitchen_enabled = command.requested_enabled
        }
        if command.execution_mode == "applied" and command.room == "sypialnia" {
            bedroom_enabled = command.requested_enabled
        }

        if command.room == "salon" {
            send VentilationConfirmation {
                room: command.room, air_quality: command.air_quality, decision: command.decision,
                requested_enabled: command.requested_enabled,
                actual_enabled: living_room_enabled, status: command.execution_mode,
                cause: command.cause, source_status: command.source_status,
                silence_age_ms: command.silence_age_ms,
                silence_timeout_ms: command.silence_timeout_ms, confirmed_at: now()
            }
        }
        if command.room == "kuchnia" {
            send VentilationConfirmation {
                room: command.room, air_quality: command.air_quality, decision: command.decision,
                requested_enabled: command.requested_enabled,
                actual_enabled: kitchen_enabled, status: command.execution_mode,
                cause: command.cause, source_status: command.source_status,
                silence_age_ms: command.silence_age_ms,
                silence_timeout_ms: command.silence_timeout_ms, confirmed_at: now()
            }
        }
        if command.room == "sypialnia" {
            send VentilationConfirmation {
                room: command.room, air_quality: command.air_quality, decision: command.decision,
                requested_enabled: command.requested_enabled,
                actual_enabled: bedroom_enabled, status: command.execution_mode,
                cause: command.cause, source_status: command.source_status,
                silence_age_ms: command.silence_age_ms,
                silence_timeout_ms: command.silence_timeout_ms, confirmed_at: now()
            }
        }
    }
}

task FailureProjection(confirmations: chan<VentilationConfirmation>) @server {
    for confirmation in confirmations {
        HomeFailure_publish(confirmation)
        log("CISZA pokoj={confirmation.room} zrodlo={confirmation.source_status} wiek={confirmation.silence_age_ms} limit={confirmation.silence_timeout_ms} decyzja={confirmation.decision} wykonanie={confirmation.status} stan={confirmation.actual_enabled}")
    }
}

pipeline FirstSilenceFlow {
    use RoomSensors -> HomeSignalMerge
    use SilenceMonitor -> HomeSignalMerge
    use HomeSignalMerge -> HomeDecisionEngine
    use HomeDecisionEngine -> VentilationController
    use VentilationController -> VentilationActuator
    use VentilationActuator -> FailureProjection
}
